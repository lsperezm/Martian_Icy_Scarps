            <mapSources>
              <edu.asu.jmars.layer.map2.WMSMapSource>
                <name>hirise_frost_probability_ls_0-10_v2</name>
                <server class="edu.asu.jmars.layer.map2.WMSMapServer" serialization="custom">
                  <unserializable-parents/>
                  <edu.asu.jmars.layer.map2.WMSMapServer>
                    <default>
